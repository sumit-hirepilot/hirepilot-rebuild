# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# node:18-alpine ships without `zip`, which the prebuild step uses to package the
# extension. ~200KB, and the alternative is implementing the ZIP format in JS.
RUN apk add --no-cache zip

COPY frontend/package*.json ./

RUN npm install

# The extension source, needed by the frontend's prebuild step which packages it
# into public/hirepilot-extension.zip for the in-app download. Without this the
# build context is frontend/ only, the prebuild finds no manifest and skips, and
# the download 404s in production. Lands at /extension, which is what
# scripts/build-extension-zip.js resolves to from /app/scripts.
COPY extension/ /extension/

COPY frontend/ .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# The site's own public origin, for og:url and og:image - the only tags that
# must state an absolute address. Unset is allowed and omits them; see
# frontend/lib/siteUrl.js for why that is preferred to guessing.
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

RUN npm run build

# Runtime stage
FROM node:18-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "start"]
