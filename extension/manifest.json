{
  "manifest_version": 3,
  "name": "HirePilot Apply",
  "version": "1.0.0",
  "description": "Executes your approved HirePilot applications on employer ATS pages, in your own browser session.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "http://localhost:3001/*",
    "http://localhost:3000/*",
    "https://hirepilot-production-e70d.up.railway.app/*",
    "https://hirepilot-rebuild-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HirePilot Apply"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "content/fields.js",
        "content/adapters/greenhouse.js",
        "content/adapters/lever.js",
        "content/adapters/ashby.js",
        "content/runner.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://hirepilot-rebuild-production.up.railway.app/*"
      ],
      "js": [
        "content/announce.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
