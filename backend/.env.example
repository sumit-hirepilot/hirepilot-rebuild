NODE_ENV=development
PORT=3000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirepilot

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=7d

# Third-party APIs
REMOTEOK_API_KEY=your_remoteok_api_key
WEWORKREMOTELY_API_KEY=your_weworkremotely_api_key
REMOTIVE_API_KEY=your_remotive_api_key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Features
AUTO_APPLY_ENABLED=true
JOB_AGGREGATION_ENABLED=true
