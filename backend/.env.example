NODE_ENV=development
PORT=3000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hirepilot

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=7d

# Third-party APIs
REMOTEOK_API_KEY=your_remoteok_api_key
WEWORKREMOTELY_API_KEY=your_weworkremotely_api_key
REMOTIVE_API_KEY=your_remotive_api_key

# Frontend URL — the CORS allowlist (middleware/cors.js).
#
# Every browser origin allowed to read this API's responses. Comma-separate to
# name more than one, which the Railway migration needs while both frontends
# are live:
#   FRONTEND_URL=https://frontend-production-0d14b.up.railway.app,https://other.up.railway.app
#
# Fails CLOSED: unset in production means no browser origin is allowed, so this
# MUST be set on a deploy before that deploy serves the frontend. Any
# http://localhost / 127.0.0.1 port is allowed automatically whenever NODE_ENV
# is not production, so local development does not depend on the value below.
FRONTEND_URL=http://localhost:3000

# Features
AUTO_APPLY_ENABLED=true
JOB_AGGREGATION_ENABLED=true
